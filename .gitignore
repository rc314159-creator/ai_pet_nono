.DS_Store

# Local automation state
/.playwright-mcp/

# Generated handoff packages and export bundles
/exports/
/reports/*.zip
/reports/product-handoff-2026-05-31/

# Root-level temporary screenshots and ad-hoc captures.
/*.png

# Node/Electron project outputs
**/node_modules/
**/dist/
**/.vite/
**/.vite-temp/
**/*.tsbuildinfo

# Local secrets and machine-specific config
.env
.env.*
!.env.example

# Runtime logs outside archived reports
/logs/
ai-pet/*.log
ai-pet/server/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
