{
  "$schema": "https://opencode.ai/config.json",
  "model": "llmmelon/deepseek-chat",
  "small_model": "llmmelon/deepseek-chat",
  "snapshot": false,
  "provider": {
    "llmmelon": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llmmelon",
      "options": {
        "baseURL": "https://llmmelon.cloud/v1",
        "apiKey": "{env:LLMMELON_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "claude-opus-4-6": {
          "name": "claude-opus-4-6",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "deepseek-chat": {
          "name": "deepseek-chat",
          "limit": {
            "context": 64000,
            "output": 8192
          }
        }
      }
    },
    "aihubmix": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "aihubmix",
      "options": {
        "baseURL": "https://aihubmix.com/v1",
        "apiKey": "{env:AIHUBMIX_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4.1-mini": {
          "name": "gpt-4.1-mini",
          "limit": {
            "context": 1047576,
            "output": 32768
          }
        }
      }
    },
    "yunwu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "yunwu",
      "options": {
        "baseURL": "https://yunwu.ai/v1",
        "apiKey": "{env:YUNWU_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-4.1-mini": {
          "name": "gpt-4.1-mini",
          "limit": {
            "context": 1047576,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "ai_pet": {
      "type": "local",
      "command": ["node", "scripts/run-mcp.cjs"],
      "enabled": true
    }
  },
  "agent": {
    "ai-pet-companion": {
      "description": "AI Pet companion agent for the desktop pet group chat.",
      "mode": "primary",
      "model": "llmmelon/deepseek-chat",
      "temperature": 0.55,
      "prompt": "{file:.opencode/prompts/ai-pet-companion.md}",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "read": false,
        "grep": false,
        "glob": false,
        "webfetch": false,
        "websearch": false,
        "todowrite": false
      },
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "read": "deny",
        "grep": "deny",
        "glob": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "todowrite": "deny",
        "ai_pet_*": "allow"
      }
    }
  },
  "default_agent": "ai-pet-companion"
}
