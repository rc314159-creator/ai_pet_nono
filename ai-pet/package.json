{
  "name": "ai-pet-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,renderer,pet,app -c teal,blue,green,magenta \"npm:dev:api\" \"npm:dev:renderer\" \"npm:dev:desktop\" \"npm:dev:app\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5180",
    "dev:app": "electron desktop-app/main.cjs",
    "dev:api": "tsx watch server/index.ts",
    "dev:desktop": "node scripts/run-openpets-dev.mjs",
    "dev:photo-pet": "electron desktop-photo-pet/main.cjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@openai/agents": "^0.11.6",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lucide-react": "^0.556.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "vite": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "electron": "^42.3.0",
    "typescript": "^5.9.3"
  }
}
