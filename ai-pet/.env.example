# Copy this file to .env.local before running the app:
#   cp .env.example .env.local
#
# The app can start without provider keys, but full AI chat needs LLMMELON_API_KEY
# and the OpenCode CLI (`npm install -g opencode-ai`).

# Agent runtime and model gateway. OpenCode is the primary Agent runtime; OpenAI Agents SDK is fallback only.
AI_PET_AGENT_RUNTIME=opencode
AI_PET_OPENCODE_PROVIDER=llmmelon
AI_PET_OPENCODE_MODEL=deepseek-chat
AI_PET_AGENT_PROVIDER=llmmelon
LLMMELON_BASE_URL=https://llmmelon.cloud/v1
LLMMELON_MODEL=deepseek-chat
# Required for full AI companion chat. Leave empty only when using local fallback demo replies.
LLMMELON_API_KEY=
AI_PET_AGENT_API_KEY=
# Optional backup gateway when llmmelon quota or streaming is unavailable.
# Set AI_PET_OPENCODE_PROVIDER=aihubmix and AI_PET_AGENT_PROVIDER=aihubmix to use it.
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=claude-sonnet-4-6
AIHUBMIX_API_KEY=
# Optional backup gateway using Yunwu OpenAI-compatible endpoint.
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_MODEL=claude-sonnet-4-6
YUNWU_API_KEY=

# Local API and renderer wiring.
# If AI_PET_API_PORT changes, update VITE_AI_PET_API_BASE_URL to match.
AI_PET_API_PORT=8788
VITE_AI_PET_API_BASE_URL=http://127.0.0.1:8788

# Voice output. Optional. Qwen3-TTS-VD requires a custom voice created by qwen-voice-design.
AI_PET_TTS_PROVIDER=qwen
AI_PET_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_PET_QWEN_API_KEY=
# Aliases accepted by the voice runtime if AI_PET_QWEN_API_KEY is empty.
DASHSCOPE_API_KEY=
ALIYUN_BAILIAN_API_KEY=
AI_PET_QWEN_VOICE_DESIGN_MODEL=qwen-voice-design
AI_PET_QWEN_TTS_MODEL=qwen3-tts-vd-2026-01-26
AI_PET_QWEN_VOICE_PREFERRED_NAME=tech_dog_demo
AI_PET_QWEN_TTS_VOICE=
AI_PET_QWEN_AUTO_CREATE_VOICE=1
AI_PET_QWEN_LANGUAGE_TYPE=Chinese
AI_PET_QWEN_SAMPLE_RATE=24000
AI_PET_QWEN_RESPONSE_FORMAT=wav

# Optional fallback runtime keys. Not needed for the default OpenCode + llmmelon path.
OPENAI_API_KEY=
AI_PET_OPENAI_API_KEY=

# The fallback OpenAI Agents SDK path disables OpenAI hosted tracing by default.
OPENAI_AGENTS_DISABLE_TRACING=1
