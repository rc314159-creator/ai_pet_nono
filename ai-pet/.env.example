# Agent runtime and model gateway. OpenCode is the primary Agent runtime; OpenAI Agents SDK is fallback only.
AI_PET_AGENT_RUNTIME=opencode
AI_PET_OPENCODE_PROVIDER=llmmelon
AI_PET_OPENCODE_MODEL=claude-sonnet-4-6
AI_PET_AGENT_PROVIDER=llmmelon
LLMMELON_BASE_URL=https://llmmelon.cloud/v1
LLMMELON_MODEL=claude-sonnet-4-6
LLMMELON_API_KEY=
VITE_AI_PET_API_BASE_URL=http://127.0.0.1:8788

# Voice output. Qwen3-TTS-VD requires a custom voice created by qwen-voice-design.
AI_PET_TTS_PROVIDER=qwen
AI_PET_QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_PET_QWEN_API_KEY=
AI_PET_QWEN_VOICE_DESIGN_MODEL=qwen-voice-design
AI_PET_QWEN_TTS_MODEL=qwen3-tts-vd-2026-01-26
AI_PET_QWEN_VOICE_PREFERRED_NAME=tech_dog_demo
AI_PET_QWEN_TTS_VOICE=
AI_PET_QWEN_AUTO_CREATE_VOICE=1
AI_PET_QWEN_LANGUAGE_TYPE=Chinese
AI_PET_QWEN_SAMPLE_RATE=24000
AI_PET_QWEN_RESPONSE_FORMAT=wav

# The fallback OpenAI Agents SDK path disables OpenAI hosted tracing by default.
OPENAI_AGENTS_DISABLE_TRACING=1
